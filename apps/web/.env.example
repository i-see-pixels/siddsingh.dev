# Copy to .env.local. On Vercel, set the same variables in the project settings.

# Neon → Connect → connection string (pooled). Also read by packages/db for migrations.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Neon Console → Auth → Configuration: the Auth URL for this branch.
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth
# At least 32 characters: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# The only account allowed into /admin.
ADMIN_EMAIL=you@example.com
# "true" opens /admin/setup to create that account once. Set back to "false" afterwards.
ADMIN_SETUP_ENABLED=false

# Vercel → Storage → Blob store → .env.local tab. Needed for image uploads only.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Google Analytics → Admin → Data streams → Web: the measurement ID (G-XXXXXXXXXX).
# Leave empty to load no analytics, as in local development.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

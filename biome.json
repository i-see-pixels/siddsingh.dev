{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "dev"
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["**", "!packages/ui/src/components", "!**/pnpm-lock.yaml"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": { "noUselessElse": "off" },
			"correctness": { "useExhaustiveDependencies": "off" },
			"a11y": {
				"noLabelWithoutControl": {
					"level": "error",
					"options": { "inputComponents": ["Input", "Textarea"] }
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "asNeeded"
		}
	},
	"css": {
		"parser": { "tailwindDirectives": true }
	},
	"assist": {
		"actions": { "source": { "organizeImports": "on" } }
	}
}
